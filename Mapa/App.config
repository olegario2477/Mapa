    <applicationSettings>
        <Mapa.Properties.Settings>
            <setting name="Mapa_getSAPData_zwsdl_map" serializeAs="String">
                <value>http://TAMGGSAPDEV.grupogusi.com.mx:8000/sap/bc/srt/rfc/sap/zwsdl_map/200/zwsdl_map/zwsdl_map</value>
